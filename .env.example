# DineFlow Firebase Configuration
# Copy this file to .env.local and fill in your values from Firebase Console -> Project Settings -> General -> Web App

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=dineflow.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dineflow
VITE_FIREBASE_STORAGE_BUCKET=dineflow.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Set to true if you want to use local Firebase Emulators
VITE_USE_FIREBASE_EMULATORS=false

